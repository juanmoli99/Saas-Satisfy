# Sólo para la rama demo-vercel (no usar valores reales ni prefijo NEXT_PUBLIC_)
DEMO_ACCESS_CODE=GENERA_UN_CODIGO_ALEATORIO_DE_AL_MENOS_20_CARACTERES
DEMO_SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_32_BYTES_BASE64URL

# Aplicación
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
DATABASE_URL=postgresql://gestion:TU_PASSWORD_LOCAL@localhost:5432/gestion_saas?schema=public
SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_32_BYTES_BASE64
ENCRYPTION_KEY=GENERA_UNA_CLAVE_ALEATORIA_DE_32_BYTES_BASE64
INTEGRATION_KEY_PEPPER=GENERA_UN_SECRETO_ALEATORIO_DE_32_BYTES_BASE64
CRON_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_32_BYTES_BASE64
BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_SOLO_PARA_LA_CARGA_INICIAL

# Mercado Pago Argentina
MERCADOPAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_MERCADO_PAGO
MERCADOPAGO_WEBHOOK_SECRET=TU_CLAVE_SECRETA_DE_WEBHOOK_MERCADO_PAGO
MERCADOPAGO_BACK_URL=https://admin.tu-dominio.com/suscripciones/resultado
MERCADOPAGO_MODE=sandbox

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=TU_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=TU_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=TU_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_VERIFY_TOKEN=GENERA_UN_TOKEN_ALEATORIO_PARA_VERIFICAR_WEBHOOK
WHATSAPP_APP_SECRET=TU_META_APP_SECRET
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_ADMIN_PHONE=54911XXXXXXXX

# Almacenamiento privado compatible con S3
S3_ENDPOINT=https://TU_ENDPOINT_S3
S3_REGION=auto
S3_BUCKET=gestion-saas-documentos
S3_ACCESS_KEY_ID=TU_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=TU_STORAGE_SECRET_KEY
S3_FORCE_PATH_STYLE=false

# Respaldo externo (debe ser un bucket/cuenta distinto del almacenamiento operativo)
BACKUP_S3_ENDPOINT=https://TU_ENDPOINT_S3_RESPALDOS
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=gestion-saas-backup
BACKUP_S3_ACCESS_KEY_ID=TU_BACKUP_ACCESS_KEY
BACKUP_S3_SECRET_ACCESS_KEY=TU_BACKUP_SECRET_KEY
BACKUP_ENCRYPTION_PASSPHRASE=GENERA_UNA_FRASE_LARGA_Y_UNICA
PG_DUMP_PATH=pg_dump

# Cotizaciones (fuente automática configurable; se admite override manual por registro)
EXCHANGE_RATE_PROVIDER=argentina_datos
EXCHANGE_RATE_API_URL=https://api.argentinadatos.com/v1/cotizaciones/dolares
