{
  "name": "gestion-saas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "credentials:generate": "tsx scripts/generate-secrets.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "date-fns": "^4.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.548.0",
    "nanoid": "^5.1.6",
    "next": "16.4.6",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true
  }
}
